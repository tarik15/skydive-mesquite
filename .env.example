# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#     cp .env.example .env
#     nano .env
#
# install.sh creates .env from this file if it is missing, generating a random
# SECRET_KEY for you, and never overwrites an existing one.

# Must match the Pi's monolith user, from: id monolith
# The container runs as this UID so it can write the NFS directories.
MONOLITH_UID=1000
MONOLITH_GID=1000

# Signs the Flask session cookie. Anyone who knows it can forge a login.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Web UI logins. The admin can upload tandem media, run zipandmove, and read
# the links and logs pages. Staff can only use the fun jumper page.
ADMIN_USER=admin
ADMIN_PASSWORD=
STAFF_USER=user
STAFF_PASSWORD=
