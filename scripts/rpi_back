#!/bin/bash

LOCK_FILE="/tmp/backup.lock"
SOURCE_DEVICE="/dev/mmcblk0"
DESTINATION_DIR="/media/nfs/pi-backup"
TIMESTAMP=$(date +%Y%m%d%H%M%S)
FILENAME="backup_${TIMESTAMP}.img"
DESTINATION_FILE="${DESTINATION_DIR}/${FILENAME}"
LOG_FILE="/var/log/rpi_backup.log"
MAX_DAYS=90

# Where to send the notifications. This lives outside the repository so it can
# be changed on this machine without committing it, and so a "git pull" cannot
# overwrite it. See skydive-media.conf.example.
CONFIG_FILE="${CONFIG_FILE:-/etc/skydive-media.conf}"
EMAIL_ADDRESS=""

# Set the PATH variable
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/games:/usr/games"

# Reading the whole SD card and writing to /var/log both need root. Check now so
# a manual run fails with something readable instead of a permission error.
if [ "$(id -u)" -ne 0 ]; then
    echo "rpi_back must be run as root, for example: sudo rpi_back" >&2
    exit 1
fi

# The configuration is read as shell by a script running as root, so anything
# written in it runs as root. Refuse it if anyone other than root can write it.
if [ -r "$CONFIG_FILE" ]; then
    if [ -n "$(find "$CONFIG_FILE" -maxdepth 0 \( -perm /go=w -o ! -user root \))" ]; then
        echo "$CONFIG_FILE must be owned by root and writable only by root." >&2
        echo "Fix it with: sudo chown root:root $CONFIG_FILE && sudo chmod 644 $CONFIG_FILE" >&2
        exit 1
    fi
    . "$CONFIG_FILE"
fi

# Function to log a message to the screen and the logfile
log() {
    local message="$1"
    echo "$(date +"%Y-%m-%d %H:%M:%S") - $message" | tee -a "$LOG_FILE"
}

# Function to send email
send_email() {
    local subject="$1"
    local message="$2"
    if [ -z "$EMAIL_ADDRESS" ]; then
        log "No EMAIL_ADDRESS set in $CONFIG_FILE, so this was not sent: $subject"
        return
    fi
    echo "$message" | mail -s "$subject" "$EMAIL_ADDRESS" ||
        log "Failed to send the \"$subject\" e-mail to $EMAIL_ADDRESS."
}

# Function to report a failure and stop
handle_error() {
    local error_message="$1"
    log "ERROR: $error_message"
    send_email "Backup Error" "$error_message"
    exit 1
}

# Only one backup at a time. The lock is held on an open file descriptor, so the
# kernel releases it however this script exits, including if it is killed or the
# Pi loses power. Nothing has to be cleaned up by hand afterwards.
exec 9>"$LOCK_FILE" || handle_error "Failed to open the lock file $LOCK_FILE."
if ! flock -n 9; then
    log "A backup is already running. Exiting."
    exit 0
fi

# Create the destination directory if it doesn't exist
mkdir -p "$DESTINATION_DIR" || handle_error "Failed to create the destination directory $DESTINATION_DIR."

# Run the backup command
log "Starting backup of $SOURCE_DEVICE to $DESTINATION_FILE"
dd if="$SOURCE_DEVICE" of="$DESTINATION_FILE" bs=1M >> "$LOG_FILE" 2>&1 ||
    handle_error "Backup failed while copying $SOURCE_DEVICE. The partial image $DESTINATION_FILE was left in place so it can be inspected and removed."

# dd can still exit successfully having written nothing useful, for instance if
# the destination disk filled up, so check the image before trusting it.
if [ ! -s "$DESTINATION_FILE" ]; then
    handle_error "Backup produced an empty image at $DESTINATION_FILE. The destination disk may be full."
fi

BACKUP_SIZE=$(du -h "$DESTINATION_FILE" | cut -f1)
log "Backup completed successfully: $DESTINATION_FILE ($BACKUP_SIZE)"
send_email "Backup Success" "Backup completed successfully: $DESTINATION_FILE ($BACKUP_SIZE)"

# Remove backup files older than MAX_DAYS
find "$DESTINATION_DIR" -name "backup_*.img" -type f -mtime +$MAX_DAYS -delete ||
    handle_error "Failed to remove old backup files from $DESTINATION_DIR."

log "Removed any backups older than $MAX_DAYS days"
